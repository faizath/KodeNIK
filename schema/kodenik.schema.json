{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "KodeNIK",
    "description": "Schema for KodeNIK Indonesian administrative NIK code database",
    "type": "object",
    "required": [
        "title",
        "version",
        "description",
        "URL",
        "author",
        "authorURL",
        "data"
    ],
    "additionalProperties": false,
    "properties": {
        "title": {
            "type": "string",
            "const": "KodeNIK.json"
        },
        "version": {
            "type": "string",
            "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}$"
        },
        "description": {
            "type": "string",
            "minLength": 1
        },
        "URL": {
            "type": "string",
            "format": "uri"
        },
        "author": {
            "type": "string",
            "minLength": 1
        },
        "authorURL": {
            "type": "string",
            "format": "uri"
        },
        "data": {
            "type": "array",
            "minItems": 38,
            "maxItems": 38,
            "items": {
                "$ref": "#/definitions/Province"
            }
        }
    },
    "definitions": {
        "Province": {
            "type": "object",
            "required": [
                "kode_provinsi",
                "nama_provinsi",
                "kabkota"
            ],
            "additionalProperties": false,
            "properties": {
                "kode_provinsi": {
                    "type": "string",
                    "pattern": "^\\d{2}$"
                },
                "nama_provinsi": {
                    "type": "string",
                    "minLength": 1
                },
                "kabkota": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/definitions/KabKota"
                    }
                }
            }
        },
        "KabKota": {
            "type": "object",
            "required": [
                "kode_kabkota",
                "nama_kabkota",
                "kecamatan"
            ],
            "additionalProperties": false,
            "properties": {
                "kode_kabkota": {
                    "type": "string",
                    "pattern": "^\\d{2}$"
                },
                "nama_kabkota": {
                    "type": "string",
                    "pattern": "^(Kab\\.|Kota) .+$"
                },
                "kecamatan": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/definitions/Kecamatan"
                    }
                }
            }
        },
        "Kecamatan": {
            "type": "object",
            "required": [
                "kode_kecamatan",
                "nama_kecamatan"
            ],
            "additionalProperties": false,
            "properties": {
                "kode_kecamatan": {
                    "type": "string",
                    "pattern": "^\\d{2}$"
                },
                "nama_kecamatan": {
                    "type": "string",
                    "minLength": 1
                }
            }
        }
    }
}
